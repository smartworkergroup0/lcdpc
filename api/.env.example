PORT=8080
FRONTEND_URL=http://localhost:4200

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=123456
DB_NAME=tuinvoice
DB_SSL=disable

# Auth
AUTH_PASSWORD_RESET_TTL_MINUTES=30
AUTH_REVOKE_SESSIONS_ON_PASSWORD_RESET=true

# Google OAuth
AUTH_GOOGLE_CLIENT_ID=
AUTH_GOOGLE_CLIENT_SECRET=
AUTH_GOOGLE_REDIRECT_URI=http://localhost:8080/api/v1/auth/register/google/callback
AUTH_GOOGLE_SCOPE=openid email profile

# CORS (comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://localhost:3000,http://localhost:5173

# OAuth2
OAUTH2_ISSUER=http://localhost:8080
OAUTH2_AUDIENCE=lcdpc-api
OAUTH2_ACCESS_TOKEN_TTL_MINUTES=60
OAUTH2_REFRESH_TOKEN_TTL_DAYS=30
OAUTH2_AUTHORIZATION_CODE_TTL_MINUTES=10
# PASETO v2.local symmetric key (64 hex chars = 32 bytes). If empty, ephemeral key is generated.
PASETO_KEY_PATH=
# If set (64 hex chars = 32 bytes), paseto.key is expected to be AES-256-GCM encrypted.
# Generate a master key: openssl rand -hex 32
# Encrypt existing key: go run main/main.go -encrypt-paseto-key <master-key-hex>
PASETO_DECRYPTION_KEY=

# Service Account PASETO key (separate from user auth)
PASETO_SA_KEY_PATH=paseto_sa.key
PASETO_SA_DECRYPTION_KEY=

# Catalog domain for service account endpoints
CATALOG_DOMAIN=https://tormesca.com

# Email driver: "resend" or "smtp"
EMAIL_DRIVER=resend

# Resend (used when EMAIL_DRIVER=resend)
RESEND_APITOKEN=
RESEND_FROM_ADDRESS=LCDPC <onboarding@resend.dev>

# SMTP (used when EMAIL_DRIVER=smtp, e.g. Mailpit on localhost:1025)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=noreply@lcdpc.local

# External Assistant API (SmartWorker)
SMARTWORKER_API_URL=https://api.smartworker.work/api
SMARTWORKER_USERNAME=
SMARTWORKER_PASSWORD=
SMARTWORKER_TOKEN_TTL_MINUTES=50

