{
  "info": {
    "name": "LCDPC API",
    "description": "Colección de endpoints para LCDPC - Productos, Combos, Precios y Sync",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "apiVersion",
      "value": "v1"
    },
    {
      "key": "apiKey",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/{{apiVersion}}/auth/login",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@lcdpc.local\",\n  \"password\": \"SuperPerro123!\"\n}"
            }
          }
        },
        {
          "name": "Me",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/{{apiVersion}}/auth/me"
          }
        },
        {
          "name": "Refresh",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/{{apiVersion}}/auth/refresh"
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/{{apiVersion}}/auth/logout"
          }
        }
      ]
    },
    {
      "name": "Productos",
      "item": [
        {
          "name": "Crear producto",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/{{apiVersion}}/productos",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Cerveza Polar\",\n  \"sku\": \"CERV-POLAR-355\",\n  \"tipoMedidaBase\": 1,\n  \"tipoComercialMayor\": 2,\n  \"unidadesPorCaja\": 12,\n  \"unidadesPorBulto\": 24\n}"
            }
          }
        },
        {
          "name": "Listar productos",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/{{apiVersion}}/productos"
          }
        },
        {
          "name": "Obtener producto por ID",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/{{apiVersion}}/productos/{{productoId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "{{apiVersion}}", "productos", "{{productoId}}"]
            },
            "variable": [
              {
                "key": "productoId",
                "value": ""
              }
            ]
          }
        },
        {
          "name": "Actualizar producto",
          "request": {
            "method": "PUT",
            "url": {
              "raw": "{{baseUrl}}/api/{{apiVersion}}/productos/{{productoId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "{{apiVersion}}", "productos", "{{productoId}}"]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Cerveza Polar Light\",\n  \"sku\": \"CERV-POLAR-355\",\n  \"tipoMedidaBase\": 1,\n  \"tipoComercialMayor\": 2,\n  \"unidadesPorCaja\": 12,\n  \"unidadesPorBulto\": 24\n}"
            },
