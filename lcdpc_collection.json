    {
      "name": "Sync",
      "description": "Endpoints de sincronización para consumidores externos (requieren X-API-Key)",
      "item": [
        {
          "name": "Sync productos (batch)",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/{{apiVersion}}/sync/productos",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-API-Key",
                "value": "{{apiKey}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "[\n  {\n    \"sku\": \"CERV-POLAR-355\",\n    \"nombre\": \"Cerveza Polar 355ml\",\n    \"tipoMedidaBase\": 1,\n    \"tipoComercialMayor\": 2,\n    \"unidadesPorCaja\": 12,\n    \"unidadesPorBulto\": 24\n  },\n  {\n    \"sku\": \"CERV-MALTA-355\",\n    \"nombre\": \"Malta Regional 355ml\",\n    \"tipoMedidaBase\": 1,\n    \"tipoComercialMayor\": 2,\n    \"unidadesPorCaja\": 12,\n    \"unidadesPorBulto\": 24\n  }\n]"
            }
          }
        },
